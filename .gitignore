# developer documents stay local (public repo carries only README/LICENSE/DATA-SOURCES)
# put ANY internal/planning note in _local/ - the whole folder is never committed,
# so nothing internal can leak by filename regardless of what it is called
_local/
docs/
CATCHMENT.md
DECISIONS.md
DEMO-SCRIPT.md
HEURISTIC.md
POC-STATE.md
REPLAY-FINDINGS.md
README-DEV.md
public/*.md
data/history/*.md

# NERLDC PSP raw PDFs stay local (hundreds of MB; parsed parquet is committed,
# and the PDFs are reproducible via backend/fetch_nerldc_psp.py --backfill)
data/history/nerldc/raw/
data/history/dam_retrain_experiment.json

# operational logs and experiment scratch - local only, never in the repo
data/history/imerg/_backfill.log
data/history/imerg/_backfill.err
data/history/obs_upstream_experiment.json
